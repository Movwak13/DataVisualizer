{
  "profiles": {
    "Spotify": {
      "is_music": true,
      "description": "Spotify extended streaming history"
    },
    "Apple Music": {
      "is_music": true,
      "description": "Apple Music privacy export play activity"
    },
    "Pandora": {
      "is_music": true,
      "description": "Pandora station and play history"
    },
    "Other": {
      "is_music": false,
      "description": "Standard tabular datasets without music metrics"
    }
  },
  "styling": {
    "default_palette": "Viridis",
    "palettes": [
      "Viridis",
      "Plasma",
      "Turbo",
      "Sunsetdark",
      "Tealgrn",
      "Bluered",
      "Cividis"
    ],
    "default_export_theme": "Dark Canvas"
  },
  "limits": {
    "max_music_catalog_items": 2500,
    "max_export_width": 1600,
    "row_pixel_height": 26
  },
  "ignored_columns": [
    "spotify_track_uri",
    "spotify_episode_uri",
    "audiobook_uri",
    "audiobook_chapter_uri",
    "ip_addr",
    "user_agent_decrypted",
    "username",
    "offline_timestamp",
    "incognito_mode",
    "offline",
    "skipped"
  ]
}
